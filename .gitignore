# Publish only the package and supported training/evaluation entrypoints.
/*
!/.gitignore
!/README.md
!/LICENSE
!/pyproject.toml
!/src/
!/tests/
!/configs/
!/scripts/
!/experiments/

/configs/*
!/configs/train.yaml
!/configs/sim_libero.yaml
!/configs/model/
!/configs/data/
!/configs/task/
/configs/model/*
!/configs/model/register_wam_libero.yaml
/configs/data/*
!/configs/data/libero_plus.yaml
/configs/task/*
!/configs/task/libero_plus.yaml

/scripts/*
!/scripts/train.py
!/scripts/train_eval_libero_plus.py
!/scripts/accelerate_configs/
!/scripts/ds_configs/
/scripts/accelerate_configs/*
!/scripts/accelerate_configs/accelerate_zero1_ds.yaml
/scripts/ds_configs/*
!/scripts/ds_configs/ds_zero1_config.json

/experiments/*
!/experiments/__init__.py
!/experiments/libero/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.env
*.log
/src/register_wam/utils/gradient_diagnostics.py
